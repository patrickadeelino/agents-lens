FROM ghcr.io/astral-sh/uv:0.11.3 AS uv

# The official Codex release package, verified against its published SHA-256.
FROM python:3.13-slim AS codex

ARG CODEX_VERSION=0.171.0
ARG TARGETARCH

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) arch=x86_64; sha=8391d67757496bfd14893eca6cbf0c96994bf2627566ff1f018f70600c9ef6b3 ;; \
      arm64) arch=aarch64; sha=d8c43bee6cf11b01eb18b95f4d7961092bc40228180808859e70dabb7784c1c9 ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-package-${arch}-unknown-linux-musl.tar.gz"; \
    python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], "/tmp/codex.tar.gz")' "$url"; \
    echo "$sha  /tmp/codex.tar.gz" | sha256sum --check; \
    mkdir /opt/codex; \
    tar -xzf /tmp/codex.tar.gz -C /opt/codex

# The official Claude Code binary, unmodified, checked against the SHA-256 of its release manifest.
FROM python:3.13-slim AS claude

ARG CLAUDE_VERSION=2.1.327
ARG TARGETARCH

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) platform=linux-x64; sha=343c744baa14bfd38286a7cb90871051f04379956da6c5b803a9e66019a76ac9 ;; \
      arm64) platform=linux-arm64; sha=acf0ef2f9da8d5ab08f193f007e19a06cbfb608b96a2f1f758d63a92a386cff8 ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    url="https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}/${platform}/claude"; \
    mkdir /opt/claude; \
    python -c 'import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], "/opt/claude/claude")' "$url"; \
    echo "$sha  /opt/claude/claude" | sha256sum --check; \
    chmod 0755 /opt/claude/claude

FROM python:3.13-slim

# Tools the agent can use. Its commands have no network access, so nothing can be installed at run time.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git python3 python-is-python3 ripgrep \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv
COPY --from=codex /opt/codex /opt/codex
COPY --from=claude /opt/claude /opt/claude

# Claude Code's sandbox needs socat, and bwrap beside its binary: the one that ships with Codex.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends socat \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /opt/codex/codex-resources/bwrap /opt/claude/bwrap

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/api-lens-venv \
    PATH="/opt/api-lens-venv/bin:$PATH"

WORKDIR /app/apps/api-lens

COPY apps/api-lens/pyproject.toml apps/api-lens/uv.lock ./
RUN uv sync --locked --no-dev --no-cache

COPY apps/api-lens/src/__init__.py ./src/
COPY apps/api-lens/src/shared/ ./src/shared/
COPY apps/api-lens/src/executor/ ./src/executor/

# The executor runs as the person's user ID, so it can edit the mounted folder.
ARG AGENT_LENS_UID=1000
ARG AGENT_LENS_GID=1000
RUN install -d -m 0700 -o "$AGENT_LENS_UID" -g "$AGENT_LENS_GID" /executor-data /executor-data/state \
    && install -d -m 0711 -o "$AGENT_LENS_UID" -g "$AGENT_LENS_GID" /executor-data/ipc \
    && chmod 0711 /executor-data

USER ${AGENT_LENS_UID}:${AGENT_LENS_GID}

# Keys arrive as Compose secrets. Codex's reaches the executor on standard input; Claude Code is offered
# only when its secret holds a key.
CMD ["sh", "-c", "[ -s /run/secrets/codex_api_key ] || { echo 'Set CODEX_API_KEY in .env or your shell, then run docker compose up again.' >&2; exit 2; }; exec python -m src.executor.main --codex-bin /opt/codex/bin/codex --model \"$AGENT_LENS_MODEL\" --claude-bin /opt/claude/claude --claude-model \"$AGENT_LENS_CLAUDE_MODEL\" --claude-key-file /run/secrets/claude_api_key --data-dir /executor-data --workspace-root /workspace < /run/secrets/codex_api_key"]
