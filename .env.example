# Do not store the Codex API key here. The host executor reads it from standard input.

# Start the host executor before Compose. The default socket is under .local/codex-executor/catalog/ipc.
# AGENT_LENS_HOST_SOCKET_DIR=/absolute/path/to/the/socket-directory

# Local observability
COMPOSE_PROFILES=observability
AGENT_LENS_OTEL_ENABLED=1
ZO_ROOT_USER_EMAIL=observer@example.com
# Required while the observability profile is enabled; see observability/README.md.
ZO_ROOT_USER_PASSWORD=
