# Required. Codex uses this OpenAI API key. Never commit the .env file.
CODEX_API_KEY=

# The only folder the agent can reach. Choose subfolders of it in the interface.
# AGENT_LENS_WORKSPACE=/absolute/path/to/your/projects

# Linux: set these if `id -u` and `id -g` print something other than 1000.
# AGENT_LENS_UID=1000
# AGENT_LENS_GID=1000

# AGENT_LENS_PORT=8080
# AGENT_LENS_MODEL=gpt-6.2-sol

# Optional local observability; see observability/README.md.
# COMPOSE_PROFILES=observability
# AGENT_LENS_OTEL_ENABLED=1
# ZO_ROOT_USER_EMAIL=observer@example.com
# ZO_ROOT_USER_PASSWORD=
