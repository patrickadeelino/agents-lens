# The host executor uses the Codex key for live runs.
CODEX_API_KEY=

# Live runs use a private Unix socket from the host executor.
# AGENT_LENS_HOST_SOCKET_DIR=/absolute/path/to/the/socket-directory

# Local observability
COMPOSE_PROFILES=observability
AGENT_LENS_OTEL_ENABLED=1
ZO_ROOT_USER_EMAIL=observer@example.com
ZO_ROOT_USER_PASSWORD=observer@example.com
